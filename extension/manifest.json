{
  "manifest_version": 3,
  "name": "Crash Predictor — Live Round Collector",
  "version": "1.6.4",
  "description": "يلتقط نتائج الجولات ويختبر إشارات مراحل اللعبة وتوقيتها داخل المتصفح دون ادعاء توقع مضمون.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://amirslama.github.io/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crash Live Collector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://amirslama.github.io/Crash-Predictor/*"
      ],
      "js": [
        "predictor-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
